+                    description="Mumdan ayrılmış, çaya və yeməyə rahat.",
+                ),
+                Service(
+                    business=business,
+                    name="Süzmə bal, 500 qr",
+                    price_text="25 ₼",
+                ),
+                Service(
+                    business=business,
+                    name="Süzmə bal, 1 kq",
+                    price_text="50 ₼",
+                ),
+                Service(
+                    business=business,
+                    name="Şanı (pətək) bal, 250 qr",
+                    price_text="17.50 ₼",
+                    description="Pətəkdən çıxdığı kimi, mumu ilə; mumu da yeyilir.",
+                ),
+                Service(
+                    business=business,
+                    name="Şanı (pətək) bal, 500 qr",
+                    price_text="35 ₼",
+                ),
+                Service(
+                    business=business,
+                    name="Şanı (pətək) bal, 1 kq",
+                    price_text="70 ₼",
+                ),
